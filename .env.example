# TokenPlan API 配置
# 请到 TokenPlan 官网获取您的 API 密钥
TOKENPLAN_API_URL=https://api.tokenplan.io
TOKENPLAN_API_KEY=your_tokenplan_api_key_here

# 服务器配置
PORT=3000

# MongoDB 配置
MONGODB_URI=mongodb://localhost:27017/soinp-furniture

# CORS 配置 (多个域名用逗号分隔)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000