# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库
MONGODB_URI=mongodb://localhost:27017/soinp-gaming

# JWT 密钥（生产环境请使用强随机字符串，可通过 node -e "console.log(require('crypto').randomBytes(64).toString('hex'))" 生成）
JWT_SECRET=a3f8e2b1c9d7f6e5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2

# CORS 允许的来源（多个用逗号分隔）
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# 管理员初始账户（首次启动后请修改密码）
